{
  "name": "apple-fest-pos",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun --hot ./index.ts",
    "dev:web": "bun run --cwd app/web dev --host 0.0.0.0",
    "build:web": "bun run --cwd app/web build",
    "start": "bun ./index.ts",
    "test": "bun test",
    "server:restart": "sudo systemctl restart apple-fest-pos",
    "deploy:pi": "./scripts/deploy-pi.sh markgoho@scout-pi.local"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "svelte": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
