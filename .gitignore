# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# Go build output
/pos
/dist-pi

# runtime database
/data

# Vendor hardware manuals kept at the repo root for reference, not shipped.
# "ITPP068 Thermal Printer Linux Software Manual 220721-1.00.pdf" is the
# manual for the two booth printers. It came from a pCloud share link that
# has expired, so the local copy is the only one. Do not delete it.
/*.pdf

# local Pi credentials, never committed
pi-access.local.md

# pen.dev CLI, a design-time tool only. It drives docs/../design/pos.pen and
# ships nothing: ADR-0003 keeps the POS one Go binary with no npm dependency,
# and a tracked package.json at the root would read as that rule breaking.
/node_modules
/package.json
/bun.lock
